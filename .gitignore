# File upload gambar user (biar repo tetap ringan)
SecondHand-Backend/uploads/

# File cache Python
SecondHand-Backend/__pycache__/
*.pyc
__pycache__/

# --- LAINNYA ---
# Environment variables (berisi password/secret)
.env
.env.local

# File sistem operasi
.DS_Store
